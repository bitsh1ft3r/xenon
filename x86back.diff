+      static void checkExt(XenonContext* context, sPPEState *ppeState) {
+        auto &thread = curThread;
+
+        if (thread.SPR.MSR.EE) {
+          if (context->iic.hasPendingInterrupts(thread.SPR.PIR)) {
+            thread.exceptReg |= ppuExternalEx;
+          }
+        }
+      }
