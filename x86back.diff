+      REGISTER_EMITTER(OPCODE_SYSCALL, Emit_SYSCALL)
+      static void Emit_SYSCALL(x86CodeGenBackend *b, const HIR::Instr *instr) {
+        x86::Gp exReg = newGP16();
+        COMP->mov(exReg, EXPtr());
+        COMP->or_(exReg, imm<u16>(ppuSystemCallEx));
